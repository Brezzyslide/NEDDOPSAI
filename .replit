modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
AI_PROVIDER = "openai"
OPENAI_MODEL = "gpt-4o-mini"
ENABLE_PAYMENT_BYPASS = "true"
EMAIL_FROM_ADDRESS = "admin@needscare.io"
EMAIL_FROM_NAME = "NEEDS CARE WORKFORCE"
EMAIL_DELIVERY_MODE = "resend"
