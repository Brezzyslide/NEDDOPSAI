# ─── NeedsOps AI+ Platform — Environment Variables ───────────────────────────
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://needsops:needsops_dev@localhost:5432/needsops

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ── Security (required in production) ────────────────────────────────────────
SESSION_SECRET=change-this-to-a-random-64-char-secret-before-deploying

# ── Email delivery ────────────────────────────────────────────────────────────
# Set EMAIL_DELIVERY_MODE=resend to send real emails via Resend.
# Leave as 'development' to log invitation links to the server console only.
EMAIL_DELIVERY_MODE=development
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=NeedsOps AI+
# Public URL of the web portal — used to build invitation acceptance links
# Example: https://my-repl.replit.dev/needsops-web
WEB_APP_URL=

# ── AI ────────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=

# ── OpenClaw Runtime Integration ─────────────────────────────────────────────
# Base URL of the OpenClaw Runtime Broker (tunneled Mac-side service)
# Set to the Cloudflare Tunnel URL from: cloudflared tunnel --url http://127.0.0.1:19002
# OPENCLAW_RUNTIME_URL=https://your-broker.trycloudflare.com
#
# Reference to the env var holding the actual broker auth token.
# The value of this var must equal BROKER_AUTH_TOKEN on the Mac broker.
# OPENCLAW_AUTH_TOKEN_REF=OPENCLAW_AUTH_TOKEN
#
# Actual bearer token (resolved at runtime via OPENCLAW_AUTH_TOKEN_REF).
# Must match BROKER_AUTH_TOKEN in the Mac broker's .env.
# Generate with: openssl rand -hex 32
# OPENCLAW_AUTH_TOKEN=replace-with-64-char-random-secret
#
# HMAC-SHA256 secret for verifying inbound webhook events from the broker.
# Must match OPENCLAW_WEBHOOK_SECRET in the Mac broker's .env.
# Generate with: openssl rand -hex 32
# OPENCLAW_WEBHOOK_SECRET=replace-with-another-64-char-secret
#
# Externally reachable base URL of this NeedsOps instance.
# Broker will POST webhook events to: ${OPENCLAW_CALLBACK_BASE_URL}/v1/runtime/events
# In Replit dev: https://XXXX.replit.dev/needsops-web
# OPENCLAW_CALLBACK_BASE_URL=https://XXXX.replit.dev/needsops-web
#
# Optional tuning (defaults shown)
# OPENCLAW_TIMEOUT_MS=30000
# OPENCLAW_RETRY_ATTEMPTS=3
# OPENCLAW_RETRY_DELAY_MS=1000
# OPENCLAW_HEARTBEAT_INTERVAL_MS=30000
# OPENCLAW_EXECUTION_TTL_SECONDS=300

# ── Future: Integrations (Sprint 2+) ─────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Desktop Connector ─────────────────────────────────────────────────────────
# NEEDSOPS_PLATFORM_URL=https://app.needsops.ai
# NEEDSOPS_CONNECTOR_ID=your-org-connector-id
