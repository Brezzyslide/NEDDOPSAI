# ─── NeedsOps Runtime Broker — Mac-side environment variables ────────────────
#
# Copy this file to .env and fill in the values before starting the broker.
# Source it before running:   source .env
# Or pass inline:             BROKER_PORT=19002 BROKER_AUTH_TOKEN=... node dist/index.mjs
#
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── HTTP server ───────────────────────────────────────────────────────────────
# Port the broker binds on 127.0.0.1 (only this port is tunneled — never expose 19001 or 19011)
BROKER_PORT=19002

# ── Authentication ────────────────────────────────────────────────────────────
# Bearer token NeedsOps must send on every request.
# Must match OPENCLAW_AUTH_TOKEN in Replit secrets.
# Generate with: openssl rand -hex 32
BROKER_AUTH_TOKEN=replace-with-a-random-64-char-secret

# ── Webhook signing ───────────────────────────────────────────────────────────
# HMAC-SHA256 shared secret for signing webhook events sent back to NeedsOps.
# Must match OPENCLAW_WEBHOOK_SECRET in Replit secrets.
# Generate with: openssl rand -hex 32
OPENCLAW_WEBHOOK_SECRET=replace-with-another-random-64-char-secret

# ── NeedsOps callback ─────────────────────────────────────────────────────────
# NOT used directly by the broker (the callbackUrl comes from each execution package).
# Shown here for reference — set OPENCLAW_CALLBACK_BASE_URL in Replit secrets to
# your Replit dev domain, e.g. https://XXXX.replit.dev/needsops-web
# The broker will POST webhook events to:  <callbackUrl from execution package>

# ── Gateway adapter ───────────────────────────────────────────────────────────
# "simulated" — runs a local state machine, no OpenClaw process needed (default)
# "live"       — connects to the OpenClaw gateway at OPENCLAW_GATEWAY_URL (Phase 4)
OPENCLAW_GATEWAY_MODE=simulated

# URL of the local OpenClaw gateway (only used when OPENCLAW_GATEWAY_MODE=live)
# Do NOT expose this port publicly — only the broker on BROKER_PORT is tunneled
OPENCLAW_GATEWAY_URL=http://127.0.0.1:19001

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file. Defaults to ~/needsops-broker.db
# BROKER_DB_PATH=/Users/you/.needsops/broker.db

# ── Webhook delivery ──────────────────────────────────────────────────────────
# Number of delivery attempts before giving up (default: 5)
# BROKER_WEBHOOK_RETRY_ATTEMPTS=5
# Base delay between retries in ms, doubled each attempt (default: 2000)
# BROKER_WEBHOOK_RETRY_BASE_MS=2000
# How often the delivery worker polls for pending events in ms (default: 5000)
# BROKER_WEBHOOK_WORKER_INTERVAL_MS=5000

# ── Payload limits ────────────────────────────────────────────────────────────
# Maximum accepted request body in bytes (default: 1 MB)
# BROKER_MAX_BODY_BYTES=1048576

# ── Cloudflare Tunnel (run separately — see runbook below) ────────────────────
# After setting the above, expose the broker:
#
#   Terminal — Mac
#   cloudflared tunnel --url http://127.0.0.1:${BROKER_PORT}
#
# Copy the printed URL (e.g. https://random-name.trycloudflare.com) and set it
# as OPENCLAW_RUNTIME_URL in Replit secrets.
#
# For a stable URL, create a named tunnel:
#   cloudflared tunnel create needsops-broker
#   cloudflared tunnel route dns needsops-broker broker.yourdomain.com
#   cloudflared tunnel run needsops-broker
