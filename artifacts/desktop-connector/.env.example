# ─────────────────────────────────────────────────────────────────────────────
# NeedsOps AI+ Runtime Broker — Mac-side environment variables
# Copy to .env and fill in real values before starting the broker.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# TCP port the broker HTTP server listens on.
# Expose ONLY this port through your tunnel — never 19001 or 19011.
BROKER_PORT=19002

# Bearer token the NeedsOps API must send on every request.
# Generate: openssl rand -hex 32
# This value must match OPENCLAW_AUTH_TOKEN in your Replit secrets.
BROKER_AUTH_TOKEN=replace-with-64-char-random-secret

# HMAC-SHA256 secret used to sign outbound webhook events.
# Generate: openssl rand -hex 32
# This value must match OPENCLAW_WEBHOOK_SECRET in your Replit secrets.
OPENCLAW_WEBHOOK_SECRET=replace-with-another-64-char-secret

# ── Gateway mode ──────────────────────────────────────────────────────────────

# Set to "live" to connect to the real OpenClaw runtime.
# Leave as "simulated" for local testing without OpenClaw installed.
OPENCLAW_GATEWAY_MODE=simulated

# ── Live gateway sub-mode (OPENCLAW_GATEWAY_MODE=live only) ──────────────────
#
# "spawn" (recommended, default)
#   Spawns `openclaw agent --mode rpc --json` as a child process per execution.
#   Communicates via JSON lines on stdin/stdout.
#   No pre-running OpenClaw server required.
#   Requires the `openclaw` binary to be on PATH (or set OPENCLAW_BIN_PATH).
#
#   Source: openclaw/package.json scripts.openclaw:rpc
#     node scripts/run-node.mjs agent --mode rpc --json
#
# "bridge-http"
#   Connects to the OpenClaw browser bridge HTTP server at OPENCLAW_GATEWAY_URL.
#   Requires OpenClaw to already be running (desktop app or openclaw gateway).
#   Routes used: GET /basic, POST /agent/act, GET /agent/snapshot,
#                POST /agent/act/hooks (cancel/abort)
#
#   Source: openclaw/extensions/browser/src/browser/bridge-server.ts
#
OPENCLAW_LIVE_MODE=spawn

# Path to the openclaw CLI binary (spawn mode only).
# Default: "openclaw" (resolved from PATH — works after `npm install -g openclaw`
# or if using the OpenClaw desktop app which adds the binary to PATH on install).
# Override if openclaw is at a custom location, e.g.:
#   OPENCLAW_BIN_PATH=/Users/you/Applications/OpenClaw.app/Contents/Resources/bin/openclaw
OPENCLAW_BIN_PATH=openclaw

# URL of the OpenClaw browser bridge server (bridge-http mode only).
# Default: http://127.0.0.1:19001
# This is the local HTTP server OpenClaw exposes for browser automation control.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:19001

# Timeout in milliseconds for gateway operations (health check, HTTP requests,
# process startup check). Default: 30000 (30 s).
OPENCLAW_GATEWAY_TIMEOUT_MS=30000

# ── Optional tuning ───────────────────────────────────────────────────────────

# Path to the SQLite database file used for local execution persistence.
# Default: ~/needsops-broker.db
# BROKER_DB_PATH=/Users/you/.config/needsops-broker/broker.db

# Maximum HTTP request body size in bytes. Default: 1048576 (1 MB).
# BROKER_MAX_BODY_BYTES=1048576

# Webhook delivery retry settings.
# BROKER_WEBHOOK_RETRY_ATTEMPTS=5       (default: 5 attempts)
# BROKER_WEBHOOK_RETRY_BASE_MS=2000     (default: 2 s — exponential backoff)
# BROKER_WEBHOOK_WORKER_INTERVAL_MS=5000 (how often pending webhooks are sent)

# How often stale (expired) executions are cleaned up. Default: 60 s.
# BROKER_STALE_CLEANUP_INTERVAL_MS=60000

# Allow local/HTTP callback URLs (useful for development when NeedsOps runs locally).
# Only affects validation — does not apply in production.
# BROKER_ALLOW_LOCAL_CALLBACKS=false

# ── Cloudflare Tunnel runbook ─────────────────────────────────────────────────
#
# The broker must be reachable by the Replit-hosted NeedsOps API.
# Use cloudflared to create a secure HTTPS tunnel to port BROKER_PORT:
#
#   # Install cloudflared (if not already installed)
#   brew install cloudflare/cloudflare/cloudflared
#
#   # Start the tunnel (one-shot URL, no config file needed for testing)
#   cloudflared tunnel --url http://127.0.0.1:19002
#
#   # The tunnel URL will look like: https://xyz-abc.trycloudflare.com
#   # Set OPENCLAW_RUNTIME_URL=https://xyz-abc.trycloudflare.com in Replit secrets.
#
# For a stable URL (recommended for production):
#   cloudflared tunnel create needsops-broker
#   cloudflared tunnel route dns needsops-broker broker.yourdomain.com
#   cloudflared tunnel run needsops-broker
#
# ── Starting the broker ───────────────────────────────────────────────────────
#
# From the needsops-repo root:
#   cp artifacts/desktop-connector/.env.example artifacts/desktop-connector/.env
#   # Edit .env with your real values
#   pnpm install
#   pnpm --filter @workspace/desktop-connector build
#   node artifacts/desktop-connector/dist/index.mjs
#
# Or in development (no build step):
#   tsx artifacts/desktop-connector/src/index.ts
