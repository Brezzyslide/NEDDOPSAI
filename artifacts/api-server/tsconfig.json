{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "paths": {
      "@workspace/shared": ["../../lib/shared/src/index.ts"],
      "@workspace/auth": ["../../lib/auth/src/index.ts"],
      "@workspace/permissions": ["../../lib/permissions/src/index.ts"],
      "@workspace/db": ["../../lib/db/src/index.ts"],
      "@workspace/db/platform": ["../../lib/db/src/platform.ts"],
      "@workspace/validation": ["../../lib/validation/src/index.ts"],
      "@workspace/api-zod": ["../../lib/api-zod/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../../lib/db" },
    { "path": "../../lib/api-zod" },
    { "path": "../../lib/shared" },
    { "path": "../../lib/auth" },
    { "path": "../../lib/permissions" },
    { "path": "../../lib/validation" }
  ]
}
